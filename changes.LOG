diff --git a/kernel/kalloc.c b/kernel/kalloc.c
index 0699e7e..5705ae7 100644
--- a/kernel/kalloc.c
+++ b/kernel/kalloc.c
@@ -13,6 +13,7 @@ void freerange(void *pa_start, void *pa_end);
 
 extern char end[]; // first address after kernel.
                    // defined by kernel.ld.
+int page_ref_count[(PHYSTOP - KERNBASE) / PGSIZE];
 
 struct run {
   struct run *next;
@@ -27,7 +28,11 @@ void
 kinit()
 {
   initlock(&kmem.lock, "kmem");
-  freerange(end, (void*)PHYSTOP);
+  char *p = (char*)PGROUNDUP((uint64)end);
+  for(; p + PGSIZE <= (char*)PHYSTOP; p += PGSIZE) {
+    page_ref_count[((uint64)p - KERNBASE) >> PGSHIFT] = 0;
+    kfree(p);
+  }
 }
 
 void
@@ -51,6 +56,14 @@ kfree(void *pa)
   if(((uint64)pa % PGSIZE) != 0 || (char*)pa < end || (uint64)pa >= PHYSTOP)
     panic("kfree");
 
+  acquire(&kmem.lock);
+  if(page_ref_count[((uint64)pa - KERNBASE) >> PGSHIFT] > 1) {
+    page_ref_count[((uint64)pa - KERNBASE) >> PGSHIFT]--;
+    release(&kmem.lock);
+    return;
+  }
+  release(&kmem.lock);
+
   // Fill with junk to catch dangling refs.
   memset(pa, 1, PGSIZE);
 
@@ -59,6 +72,7 @@ kfree(void *pa)
   acquire(&kmem.lock);
   r->next = kmem.freelist;
   kmem.freelist = r;
+  page_ref_count[((uint64)pa - KERNBASE) >> PGSHIFT] = 0;
   release(&kmem.lock);
 }
 
@@ -72,11 +86,30 @@ kalloc(void)
 
   acquire(&kmem.lock);
   r = kmem.freelist;
-  if(r)
+  if(r) {
+    page_ref_count[((uint64)r - KERNBASE) >> PGSHIFT] = 1;
     kmem.freelist = r->next;
+  }
   release(&kmem.lock);
 
   if(r)
     memset((char*)r, 5, PGSIZE); // fill with junk
   return (void*)r;
 }
+
+void 
+add_page_ref_count(uint64 pa, int ref_count)
+{
+  acquire(&kmem.lock);
+  page_ref_count[(pa - KERNBASE) >> PGSHIFT] += ref_count;
+  release(&kmem.lock);
+}
+
+int
+get_page_ref_count(uint64 pa) {
+  int count = 0;
+  acquire(&kmem.lock);
+  count = page_ref_count[(pa - KERNBASE) >> PGSHIFT];
+  release(&kmem.lock);
+  return count;
+}
diff --git a/kernel/printf.c b/kernel/printf.c
index 1a50203..dac6f8c 100644
--- a/kernel/printf.c
+++ b/kernel/printf.c
@@ -122,6 +122,7 @@ panic(char *s)
   printf("panic: ");
   printf(s);
   printf("\n");
+  backtrace();
   panicked = 1; // freeze uart output from other CPUs
   for(;;)
     ;
@@ -133,3 +134,15 @@ printfinit(void)
   initlock(&pr.lock, "pr");
   pr.locking = 1;
 }
+
+void
+backtrace(void)
+{
+  printf("backtrace:\n");
+  uint64 top_fp = r_fp();
+  uint64 this_fp = top_fp;
+  while(PGROUNDDOWN(top_fp) == PGROUNDDOWN(this_fp)) {
+    printf("%p\n", *(uint64*)(this_fp-8));
+    this_fp = *(uint64*)(this_fp-16);
+  }
+}
\ No newline at end of file
diff --git a/kernel/riscv.h b/kernel/riscv.h
index 20a01db..c86c48f 100644
--- a/kernel/riscv.h
+++ b/kernel/riscv.h
@@ -319,6 +319,14 @@ r_ra()
   return x;
 }
 
+static inline uint64
+r_fp()
+{
+  uint64 x;
+  asm volatile("mv %0, s0" : "=r" (x) );
+  return x;
+}
+
 // flush the TLB.
 static inline void
 sfence_vma()
@@ -343,6 +351,7 @@ typedef uint64 *pagetable_t; // 512 PTEs
 #define PTE_W (1L << 2)
 #define PTE_X (1L << 3)
 #define PTE_U (1L << 4) // user can access
+#define PTE_C (1L << 8) // Copy-on-write page
 
 // shift a physical address to the right place for a PTE.
 #define PA2PTE(pa) ((((uint64)pa) >> 12) << 10)
